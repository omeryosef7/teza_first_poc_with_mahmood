.env
.cache/
__pycache__/
*.py[cod]
outputs/stage4/token_dynamics/*/token_level_metrics.jsonl
outputs/stage4/token_dynamics/full_20260604_101929/plots_analysis_v2/per_prompt/
# Stage 4.7 — exclude per-generation JSON artifacts (contain raw model outputs) and stale run
outputs/stage4_7/runs/*/runs/
outputs/stage4_7/runs/*/logs/
outputs/stage4_7/runs/run_array_20260610_1414/outputs/
outputs/
TROPT/
doublespeak_causality/data/gcg/
doublespeak_causality/outputs/gcg/gcg_suffixes_used.json

# SLURM logs (huge transformers progress-bar spam; never commit)
logs/

# Boombness sprint: activation caches are large (~500MB/run) and reproducible from the run config
outputs/boombness/**/cache/

# PyTorch RPC scratch dirs (`_remote_module_non_scriptable.py`) created in the repo root by
# every pytest run that imports torch. They are regenerable and carry no research content,
# but an untracked directory dirties `git status` -- which this project uses every tick to
# detect artifact corruption (C-2, where a concurrent test run rewrote a committed result).
# A check that is routinely noisy is a check that gets ignored.
tmp*/
